# Port server backend Express
PORT=4000

# Mode lingkungan (development | production)
NODE_ENV=development

# Alamat URL frontend React yang diizinkan oleh CORS
# Di produksi: ganti dengan domain HTTPS resmi (misal: https://campussphere.iti.ac.id)
CLIENT_ORIGIN=http://localhost:5173

# Domain email resmi kampus yang diizinkan mendaftar (pisahkan dengan koma jika lebih dari satu)
ALLOWED_CAMPUS_DOMAINS=iti.ac.id

# Nama institusi kampus
CAMPUS_NAME=Institut Teknologi Indonesia

# Rahasia sesi (WAJIB diganti dengan string acak kriptografis 64+ karakter di produksi!)
SESSION_SECRET=dev-only-secret-change-in-production-campussphere-2026

# ============================================================================
# PERSIAPAN PRODUKSI MASA DEPAN (FASE 9 — BELUM DIAKTIFKAN DI PROTOTIPE INI)
# ============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/campussphere_db
# REDIS_URL=redis://localhost:6379
